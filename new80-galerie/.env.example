# Copier en .env.local (dev) et renseigner les mêmes valeurs dans Cloudflare (prod).
# Les variables NEXT_PUBLIC_* sont intégrées au build : elles doivent aussi être définies dans les variables de BUILD Cloudflare.

# Site
NEXT_PUBLIC_SITE_URL=https://photos.new80.fr
NEXT_PUBLIC_REMOVAL_EMAIL=contact@new80.fr

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2
NEXT_PUBLIC_R2_PUBLIC_URL=https://img.new80.fr
R2_ACCOUNT_ID=
R2_BUCKET=new80-photos
# Secrets (R2 > Manage API tokens, droits Object Read & Write sur le bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
